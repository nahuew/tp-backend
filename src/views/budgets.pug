extends layout

block content
  h2 Presupuestos de la obra #{jobId}

  if budgets.length === 0
    p No hay presupuestos para esta obra
  else
    table(border="1")
      tr
        th ID
        th Nombre
        th Ubicación
        th Monto
        th Estado
        th Fecha incio
        th Fecha fin estimada

      each b in budgets
        tr
          td= b._id
          td= b.name
          td= b.location
          td= b.amount
          td= b.status
          td= new Date(b.startDate).toLocaleDateString('es-AR')
          td= new Date(b.estimatedEndDate).toLocaleDateString('es-AR')
  br
  a(href="/jobs/view" class="btn") Volver
  