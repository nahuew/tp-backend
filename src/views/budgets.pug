extends layout

block content
  h2 Presupuestos #{jobId}

  if budgets.length === 0
    p No hay presupuestos
  else
    table(border="1")
      tr
        th ID
        th Nombre de obra
        th Monto Mano de Obra
        th Monto Materiales
        th Monto Total
        th Estado

      each b in budgets
        tr
          td= b._id
          td= b.name
          td= b.amountmo
          td= b.amountmat
          td= b.amountot
          td= statusMap[b.status]
  br
  a(href="/jobs/view" class="btn") Volver
  

