doctype html

html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")

        link(rel="stylesheet", href="/css/style.css")

        link(rel="preconnect", href="https://fonts.googleapis.com")
        link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
        link(href="https://fonts.googleapis.com/css2?family=Domine:wght@400..700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap", rel="stylesheet")

        script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")

        title Login

    body.login

        section.login-card

            h1.tittle-login Bienvenido
            h2.subtitle-login Inicia sesión

            form(action="/login", method="POST")

                div.user
                    label(for="email") Email
                    input(
                        type="email",
                        name="email",
                        id="email",
                        placeholder="correo@ejemplo.com",
                        required
                    )

                div.user
                    label(for="password") Contraseña
                    input(
                        type="password",
                        name="password",
                        id="password",
                        placeholder="*********",
                        required
                    )

                button(type="submit") Ingresar

            br

            p
                | ¿No tienes cuenta? 
                a(href="/signUp") Regístrate

        if flash
            script.
                Swal.fire({
                icon: "#{flash.type}",
                title: "#{flash.type === 'success' ? 'Éxito' : 'Error'}",
                text: "#{flash.message}"
                });

