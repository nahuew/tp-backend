extends layout

block content
  .new-container
    .form-card
      h2 Nuevo presupuesto

      form(method="POST" action="/budgets")
        input(type="hidden" name="job_id" value=jobId)

        label(for="name") Nombre de Obra:
        input(type="text" name="name" required)
        label(for="amount") Monto Mano de Obra :
        input(type="number" name="amountmo" required)
        label(for="amount") Monto Materiales:
        input(type="number" name="amountmat" required)
        label(for="amount") Monto Total:
        input(type="number" name="amountot" required)    
        label(for="status") Estado:
        select(name="status" required)
          option(value="waiting") Pendiente de Aprobación
          option(value="approved") Aprobado 
          option(value="rejected") Rechazado

    
        label(for="description") Descripción:
        input(type="text" name="description")

        button(type="submit") Crear presupuesto

      br
      a(href="javascript:history.back()" class="btn") Volver