extends layout

block content
  .new-container
    .form-card
      h2 Detalle de Presupuesto

      p
        strong DNI/CUIT de Cliente:
        |  #{budget.idCustomer}
      p
        strong Nombre de Cliente:
        |  #{budget.nameCustomer}
      p
        strong Monto Mano de Obra:
        |  #{budget.amountmo}
      p
        strong Monto Materiales:
        |  #{budget.amountmat}
      p
        strong Monto Total:
        |  #{budget.amountot}
      p
        strong Estado:
        |  #{statusMap[budget.status]}
      p
        strong Descripción:
        |  #{budget.description}

      br
      .actions

        a.btn(href="javascript:history.back()")
          | Volver

        a.btn(href=`/budgets/${budget._id}/edit`)
          | Editar

        if user && user.role === "admin"
          form.confirm-delete(
            method="POST"
            action=`/budgets/${budget._id}?_method=DELETE`
          )
            button.btn.btn-danger(type="submit")
              | Eliminar