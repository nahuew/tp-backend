extends layout

block content
	.index-container

		br
		h2 Lista de obras
		.table-wrapper
			table
				thead
					tr 
						th Nombre
						th Ubicación
						th Director
						th Estado
						th Fecha de inicio
						th Fecha estimada de fin
						th
				tbody
					each job in jobs
						tr
							td= job.name
							td= job.location
							td= job.director_id.name
							td= statusMap[job.status]
							td= new Date(job.startDate).toLocaleDateString('es-AR', { timeZone: 'UTC' })
							td= new Date(job.estimateEndDate).toLocaleDateString('es-AR', { timeZone: 'UTC' })
							td
								a(href="/jobs/view/" + job._id)  Ver