doctype html

html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")

        link(rel="stylesheet", href="/css/style.css")

        link(rel="preconnect", href="https://fonts.googleapis.com")
        link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
        link(href="https://fonts.googleapis.com/css2?family=Domine:wght@400..700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap", rel="stylesheet")

        script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")

        title Registro

    body.login
        section.login-card
            h1.tittle-login Bienvenido
            h2.subtitle-login Crea tu cuenta

            if error
                p.error-message= error

            form(action="/signUp", method="POST")
                div.user
                    label(for="name") Nombre
                    input(
                        type="text",
                        name="name",
                        id="name",
                        placeholder="Tu nombre",
                        required
                    )

                div.user
                    label(for="email") Email
                    input(
                        type="email",
                        name="email",
                        id="email",
                        placeholder="correo@ejemplo.com",
                        required
                    )

                div.user
                    label(for="password") Contraseña
                    input(
                        type="password",
                        name="password",
                        id="password",
                        placeholder="*********",
                        required
                    )
                    p.password-hint La contraseña debe tener:
                    ul.password-hint-list
                        li#length.min 8 caracteres
                        li#upper.upper Una mayúscula
                        li#lower.lower Una minúscula
                        li#special.special Un carácter especial

                    div.strength-container
                        div#strength-bar.strength-bar
                    p#strength-text.strength-text

                button#submit-btn(type="submit" disabled) Registrarse

            p
                | ¿Ya tienes cuenta? 
                a(href="/login") Inicia sesión

        script(src="/js/signup.js")

        if flash
            script.
                Swal.fire({
                    icon: "#{flash.type}",
                    title: "#{flash.type === 'success' ? 'Éxito' : 'Error'}",
                    text: "#{flash.message}"
                });
