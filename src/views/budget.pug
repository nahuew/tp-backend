extends layout

block content
  h2 Presupuestos #{jobId}

  if budgets.length === 0
    p No hay presupuestos
  else
    table(border="1")
      tr  
        th DNI/CUIT de Cliente
        th Nombre de cliente
        th Monto Mano de Obra
        th Monto Materiales
        th Monto Total
        th Estado
        th

      each b in budgets
        tr
          td= b.idCustomer
          td= b.nameCustomer
          td= b.amountmo
          td= b.amountmat
          td= b.amountot
          td= statusMap[b.status]
          td 
            a(href="/budgets/" + b._id class="btn") Ver detalle
  br

  a(href="/budgets/new" class="btn") Nuevo Presupuesto
  |  
  a(href="/jobs/view" class="btn") Volver
