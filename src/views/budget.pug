extends layout

block content
	.page
		.page-header
			h2 Presupuestos
			.page-actions
				a.btn(href="/budgets/new") Nuevo presupuesto
				a.btn.btn-secondary(href="javascript:history.back()") Volver

		if budgets.length === 0
			.empty-state No hay presupuestos para mostrar.
		else
			.table-wrapper
				table
					thead
						tr
							th DNI/CUIT
							th Cliente
							th Mano de obra
							th Materiales
							th Total
							th Estado
							th
					tbody
						each b in budgets
							tr
								td= b.idCustomer
								td= b.nameCustomer
								td= b.amountmo
								td= b.amountmat
								td= b.amountot
								td
									span(class=`badge badge-${b.status}`)= statusMap[b.status]
								td
									a.btn.btn-secondary(href="/budgets/" + b._id) Ver detalle
