extends layout

block content
  .new-container
    .form-card
      h2 Nueva obra

      //SELECCIONA PRESUPUESTO CREADO
      form(method="POST" action="/jobs")
        label(for="budget_id") Presupuesto asociado:
        select(name="budget_id" required)
          option(value="" disabled selected) Seleccioná un presupuesto
          each b in budgets
            option(value=b._id)= b.nameCustomer + " — $" + b.amountot

        label(for="name") Nombre:
        input(type="text" name="name" required)

        label(for="location") Ubicación:
        input(type="text" name="location" required)

        label(for="director") Director:
        input(type="text" name="director" required)

        label(for="status") Estado:
        select(name="status" required)
          option(value="planning") Planificada
          option(value="active") Activa
          option(value="completed") Finalizada
          option(value="cancelled") Cancelada

        label(for="startDate") Fecha de inicio:
        input(type="date" name="startDate" required)

        label(for="estimateEndDate") Fecha de fin estimada:
        input(type="date" name="estimateEndDate" required)

        button(type="submit") Guardar