extends layout

block content

  h2 Detalle obra

  p
    strong ID:
    | #{job._id}

  p
    strong Nombre:
    | #{job.name}

  p
    strong Ubicación:
    | #{job.location}
  
  p
    strong Director:
    | #{job.director}

  br
  a(href="/jobs/view" class="btn") Volver 
  
  if budget
    a(href="/budgets/" + budget._id class="btn") Ver presupuesto
  else
    p Sin presupuesto vinculado

  br
