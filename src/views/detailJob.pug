extends layout

block content

  h2 Detalle obra

  p
    strong Nombre: 
    | #{job.name}

  p
    strong Ubicación: 
    | #{job.location}

  p
    strong Director: 
    | #{job.director_id.name}

  br

  .actions

    a.btn(href=`/jobs/${job._id}/edit`)
      | Editar

    if user && user.role === "admin"
      form.confirm-delete(
        method="POST"
        action=`/jobs/${job._id}?_method=DELETE`
      )
        button.btn.btn-danger(type="submit")
          | Eliminar

  br
  br

  h3 Presupuestos asociados

  if budgets.length > 0

    ul
      each budget in budgets

        li

          p Cliente: #{budget.nameCustomer}

          p Estado: #{budgetStatusMap[budget.status]}

          a.btn(href=`/budgets/${budget._id}`)
            | Ver detalle

          br
          br

  else

    p No hay presupuestos vinculados

  br

  a(href="javascript:history.back()" class="btn")
    | Volver

  if job.status === "planning" || job.status === "active"
    a(href="/budgets/new" class="btn")
      | Nuevo presupuesto
      

