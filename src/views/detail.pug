extends layout

block content

  h2 Detalle obra

  p
    strong ID:
    | #{job._id}

  p
    strong Nombre:
    | #{job.name}

  p
    strong Ubicación:
    | #{job.location}
  
  p
    strong Director:
    | #{job.director}

  br
  a(href="/jobs/view" class="btn") Volver 
  a(href=`/budgets/job/${job._id}` class="btn") Ver presupuestos
  a(href="/budgets/new" class="btn") Agregar presupuesto

  br
